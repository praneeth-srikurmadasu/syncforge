# Copy to .env and replace placeholders. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose, Phase 2)
POSTGRES_USER=syncforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=syncforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Docker Compose, Phase 5)
REDIS_URL=redis://localhost:6379/0

# JWT (Phase 2). Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-value
