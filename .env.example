# Copy to .env and replace placeholders. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose)
POSTGRES_USER=syncforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=syncforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Docker Compose) - message broker for the background workers.
REDIS_URL=redis://localhost:6379/0
# Seconds a worker owns a claimed event; after that a crashed worker's event is re-sent.
WORKER_LEASE_SECONDS=300
# Outbox relay: rows published per poll, and seconds between polls.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1

# Retries of failed synchronization steps: attempts in total (first included), first
# delay in seconds (doubles each time), longest delay, and jitter (0.2 = +/-20%).
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=300
RETRY_JITTER_RATIO=0.2

# JWT access tokens. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below works for local development only; production refuses it.
JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API (JSON list). Default: the Angular dev server.
CORS_ORIGINS=["http://localhost:4200"]

# Connectors (Phase 4).
# Fernet key that encrypts connector credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (the first encrypts, all decrypt).
# Leave empty to run without connectors; production refuses to start without it.
CONNECTOR_ENCRYPTION_KEY=
# Hosts connectors may call (JSON list) - protects against server-side request forgery.
CONNECTOR_ALLOWED_HOSTS=["localhost","127.0.0.1"]
CONNECTOR_CONNECT_TIMEOUT_SECONDS=3
CONNECTOR_READ_TIMEOUT_SECONDS=10
# Default endpoints: the local mock services (mock-services/README.md).
SLACK_BASE_URL=http://127.0.0.1:9101
GOOGLE_WORKSPACE_BASE_URL=http://127.0.0.1:9102
PAYROLL_BASE_URL=http://127.0.0.1:9103
